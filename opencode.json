{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (Local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Local Qwen 3.6 model",
          "max_tokens": 65536
        }
    }
  }},
  "lsp": {
    "rust-analyzer": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"],
      "initialization": {
        "checkOnSave": {
          "command": "clippy"
        }
      }
    },
    "permission": {
      "lsp": "allow"
    }
  },
  "model": "local-llamacpp/qwen3.6-35b-a3b"
}
